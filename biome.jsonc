{
  "$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**/*.{css,json,mjs,ts,tsx}",
      "!**/.turbo/**",
      "!**/gen/**",
      "!**/node_modules/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "recommended": true,
        "useButtonType": "error"
      },
      "complexity": {
        "recommended": true,
        "noForEach": "error",
        "noUselessContinue": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "useArrowFunction": "error",
        "useDateNow": "error",
        "useFlatMap": "error"
      },
      "correctness": {
        "recommended": true,
        "useJsxKeyInIterable": "error",
        "noUnsafeFinally": "error"
      },
      "nursery": {
        "recommended": true,
        "noAwaitInLoop": "error",
        "noImportantStyles": "off",
        // "noImportCycles": "error", // Don't use while in dev!
        "noShadow": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "fix": "safe",
          "options": {
            "style": "type"
          }
        }
      },
      "performance": {
        "recommended": true,
        "noAccumulatingSpread": "error"
      },
      "security": {
        "recommended": true
      },
      "style": {
        "recommended": true,
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConst": "error",
        "useExportType": "error",
        "useForOf": "error"
      },
      "suspicious": {
        "recommended": true,
        "noAlert": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["debug", "error", "info", "time", "timeEnd", "warn"]
          }
        },
        "noDebugger": "error",
        "noExplicitAny": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedAttributes": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":BUN:",
                ":NODE:",
                ":PACKAGE:",
                ":PACKAGE_WITH_PROTOCOL:",
                ":ALIAS:"
              ],
              [":PATH:", "!./*.module.css"],
              ":BLANK_LINE:",
              ["./*.css"]
            ]
          }
        }
      }
    }
  }
}
