{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": []
    },
    "deploy": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    }
  },
  "globalEnv": ["MODE", "NODE_ENV"]
}
